---
import Base from '../layouts/Base.astro';

const links = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/svanschooten/' },
  { label: 'GitHub', href: 'https://github.com/svanschooten' },
  { label: 'Instagram', href: 'https://www.instagram.com/stijnvanschooten/' },
];
---

<Base title="Contact">
  <h1>Contact</h1>
  <ul>
    {links.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
  </ul>
</Base>
