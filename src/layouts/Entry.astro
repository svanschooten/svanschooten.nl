---
import { render, type CollectionEntry } from 'astro:content';
import PostDate from '../components/PostDate.astro';
import Base from './Base.astro';

interface Props {
  entry: CollectionEntry<'blog' | 'projects'>;
  backLabel: string;
}

const { entry, backLabel } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <article>
    <a class="back" href={`/${entry.collection}/`}>← {backLabel}</a>
    <h1>{entry.data.title}</h1>
    <PostDate date={entry.data.date} period={entry.data.period} />
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
